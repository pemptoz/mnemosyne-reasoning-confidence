# =============================================================================
# Secrets — ensemble du dépôt
# =============================================================================

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx


# =============================================================================
# Environnements Python de data-analyse
# =============================================================================

/data-analyse/venv/
/data-analyse/.venv/
/data-analyse/env/
/data-analyse/.env/


# =============================================================================
# Fichiers temporaires Python de data-analyse
# =============================================================================

/data-analyse/**/__pycache__/
/data-analyse/**/*.py[cod]
/data-analyse/**/*.so

/data-analyse/.pytest_cache/
/data-analyse/.mypy_cache/
/data-analyse/.ruff_cache/
/data-analyse/.coverage
/data-analyse/htmlcov/


# =============================================================================
# Éditeurs et système
# =============================================================================

/data-analyse/.vscode/
/data-analyse/.idea/

data-analyse/.DS_Store
data-analyse/**/.DS_Store
data-analyse/Thumbs.db
data-analyse/**/Thumbs.db

/data-analyse/*~
/data-analyse/**/*.swp
/data-analyse/**/*.swo


# =============================================================================
# Dépendances externes et installations locales
# =============================================================================

# Installation locale de Clozure Common Lisp.
/data-analyse/.ccl/

# Sources Lisp locales de mReasoner.
/data-analyse/.mreasoner/


# =============================================================================
# Données
# =============================================================================

# Données brutes téléchargées depuis OSF ou une autre source.
/data-analyse/data/raw/**
!/data-analyse/data/raw/.gitkeep
!/data-analyse/data/raw/README.md

# Datasets produits par les scripts de conversion.
/data-analyse/data/processed/**
!/data-analyse/data/processed/.gitkeep
!/data-analyse/data/processed/README.md

# Caches de simulation.
/data-analyse/data/cache/**
!/data-analyse/data/cache/.gitkeep
!/data-analyse/data/cache/README.md

# Journaux de données éventuellement générés.
/data-analyse/data/logs/**
!/data-analyse/data/logs/.gitkeep
!/data-analyse/data/logs/README.md


# =============================================================================
# Résultats générés
# =============================================================================

/data-analyse/results/logs/**
!/data-analyse/results/logs/.gitkeep
!/data-analyse/results/logs/README.md

/data-analyse/results/benchmarks/**
!/data-analyse/results/benchmarks/.gitkeep
!/data-analyse/results/benchmarks/README.md

/data-analyse/results/analysis/**
!/data-analyse/results/analysis/.gitkeep
!/data-analyse/results/analysis/README.md

/data-analyse/results/figures/**
!/data-analyse/results/figures/.gitkeep
!/data-analyse/results/figures/README.md

/data-analyse/results/tables/**
!/data-analyse/results/tables/.gitkeep
!/data-analyse/results/tables/README.md


# =============================================================================
# Fichiers générés accidentellement à la racine de data-analyse
# =============================================================================

/data-analyse/dataset_ccobra_*.csv
/data-analyse/mental_models*.csv
/data-analyse/mental_models*.json
/data-analyse/mreasoner_*_cache*.npz
